# 环境变量配置
# 应用
APP_NAME=tiangong-agent
APP_ENV=dev
APP_DEBUG=false

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=medical
DB_PASSWORD=medical123
DB_NAME=medical_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=knowledge-docs
MINIO_SECURE=false

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=medical123

DASHSCOPE_API_KEY=xxxx
# 聊天模型
BASE_URL_CHAT=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=deepseek-chat

DEEPSEEK_API_KEY=xxx
DEEPSEEK_MODEL=deepseek-chat
EMBEDDING_MODEL=text-embedding-v3
VL_MODEL=qwen-vl
# 日志
LOG_LEVEL=DEBUG
LOG_DIR=logs

# 鉴权：生成方式 python -c "import secrets; print(secrets.token_hex(32))"
# 不设置时使用进程内随机密钥，重启后所有 token 失效
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=30

# TruLens 评估（可选）
TRULENS_DB_NAME=trulens_eval
ENABLE_TRULENS=true

# MinerU 文档解析服务（可选，填你自己的服务地址）
MINERU_API_URL=
MINERU_BACKEND=hybrid-auto-engine
MINERU_TIMEOUT=300
